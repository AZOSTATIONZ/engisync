# ─────────────────────────────────────────────
# EngiSync environment variables
# Copy to `.env` and fill in real values.
# ─────────────────────────────────────────────

# Database (PostgreSQL) — Supabase / Railway / local
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/engisync?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Base URL of the app (used for callbacks)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Microsoft (Azure AD / Entra) OAuth
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"

# Storage (Supabase Storage / AWS S3) — used in later phases
STORAGE_BUCKET="engisync-files"

# ── AI Assistant (Phase 8) ──
# Set ONE of the keys below. If both are set, AI_PROVIDER decides (default: anthropic).
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Optional overrides:
# AI_PROVIDER="anthropic"   # or "openai"
# AI_MODEL="claude-3-5-sonnet-latest"   # or e.g. "gpt-4o-mini"

# ── Email (Phase 11) — optional. Pick ONE path. ──
# "From" address shown on emails:
EMAIL_FROM="EngiSync <no-reply@example.com>"
# Path A — Resend (free tier). Get a key at resend.com:
RESEND_API_KEY=""
# Path B — SMTP (e.g. a free Gmail App Password). Leave RESEND_API_KEY empty to use this:
SMTP_HOST=""            # e.g. smtp.gmail.com
SMTP_PORT="587"
SMTP_SECURE="false"     # true for port 465
SMTP_USER=""            # your email address
SMTP_PASS=""            # app password (NOT your normal password)

# ── Web push (Phase 11) — optional, FREE. ──
# Generate a keypair once:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Node environment
NODE_ENV="development"
