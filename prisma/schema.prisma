// EngiSync — Prisma schema
// Phase 1 (Foundation): users, roles, auth, workspaces.
// Later phases (tasks, files, meetings, budget, AI) extend this schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────

enum SystemRole {
  GUEST
  INDIVIDUAL
  ADMIN
}

enum Plan {
  FREE
  STUDENT_PREMIUM
  UNIVERSITY
}

/// Workspace roles.
///
/// Deliberately THREE, not six. "Assistant Leader" is not an identity — it is
/// one capability (approving things) that a leader delegates. Modelling it as
/// a role would add a permission tier every future check has to reason about;
/// modelling it as a capability grant on WorkspaceMember keeps the tier count
/// low while expressing exactly the same thing.
///
/// Department Admin and Supervisor are deliberately NOT here: they operate at
/// the department level and are checked separately.
enum WorkspaceRole {
  LEADER
  MEMBER
  /// Read-only: supervisors observing, and guests on shared links.
  VIEWER
}

enum DepartmentRole {
  ADMIN
  MEMBER
  SUPERVISOR
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CollaborationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum EventType {
  EVENT
  DEADLINE
  MEETING
  REMINDER
}

enum NotificationType {
  TASK_DUE
  WORKSPACE
  MENTION
  SYSTEM
}

enum MeetingProvider {
  GOOGLE_MEET
  ZOOM
  MS_TEAMS
  GOOGLE_CLASSROOM
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ContributionMethod {
  ECOCASH
  ONEMONEY
  INNBUCKS
  CASH
  BANK
  OTHER
}

enum ExpenseCategory {
  COMPONENTS
  TOOLS
  PRINTING
  TRANSPORT
  SOFTWARE
  SERVICES
  OTHER
}

// ── Auth.js models ────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only users
  systemRole    SystemRole @default(INDIVIDUAL)

  // Notification preferences
  emailNotifications Boolean @default(false)

  // Subscription plan (admin-assigned for now; payments later).
  plan Plan @default(FREE)

  // Two-factor
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  accounts     Account[]
  sessions     Session[]
  memberships  WorkspaceMember[]
  ledWorkspaces Workspace[] @relation("WorkspaceLeader")

  createdTasks  Task[] @relation("TaskCreator")
  assignedTasks Task[] @relation("TaskAssignee")
  timeLogs      TimeLog[]
  events        CalendarEvent[] @relation("EventCreator")
  notifications Notification[]
  files         FileResource[]  @relation("FileUploader")
  shareLinks    ShareLink[]     @relation("ShareCreator")
  createdMeetings Meeting[]     @relation("MeetingCreator")
  attendances   Attendance[]
  contributions Contribution[] @relation("Contributor")
  expensesSpent Expense[]      @relation("ExpenseSpender")
  deptMemberships   DepartmentMember[]
  createdDepartments Department[]     @relation("DeptCreator")
  deptAnnouncements DepartmentAnnouncement[] @relation("DeptAnnouncementAuthor")
  joinRequests      JoinRequest[]
  pushSubscriptions PushSubscription[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  endpoint String @unique
  p256dh   String
  auth     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Workspaces (group projects) ───────────────

/// The engineering project lifecycle.
///
/// These are ADVISORY, not gates. Nothing in the app blocks an action because
/// of the current stage — a student who needs to upload a document during
/// "Planning" must always be able to. The stage describes where the project is
/// so progress can be communicated and paced; it never restricts what a team
/// can do.
enum ProjectStage {
  IDEA
  PROPOSAL
  PLANNING
  DESIGN
  SIMULATION
  IMPLEMENTATION
  TESTING
  DOCUMENTATION
  PRESENTATION
  COMPLETED
}

model Workspace {
  id          String  @id @default(cuid())
  name        String
  description String?
  // Join controls
  joinCode    String  @unique
  pinHash     String? // hashed PIN for extra protection

  // Project management
  objectives String?
  scope      String?

  // Engineering lifecycle. `stageEnteredAt` is what makes "are we behind
  // schedule?" answerable — without a timestamp we can only say where a
  // project is, never how long it has been stuck there.
  stage         ProjectStage @default(IDEA)
  stageEnteredAt DateTime    @default(now())
  /// Optional target end date, used to pace expected progress.
  targetEndDate DateTime?

  // Budget
  budgetTarget Decimal? @db.Decimal(12, 2)
  currency     String   @default("USD")

  // Department this group belongs to (nullable for legacy groups).
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Secure access controls.
  maxMembers      Int?     // null = unlimited
  requireApproval Boolean  @default(false)

  leaderId String
  leader   User   @relation("WorkspaceLeader", fields: [leaderId], references: [id])

  members       WorkspaceMember[]
  tasks         Task[]
  events        CalendarEvent[]
  files         FileResource[]
  meetings      Meeting[]
  contributions Contribution[]
  expenses      Expense[]
  joinRequests  JoinRequest[]
  invites       GroupInvite[]
  collaborations WorkspaceCollaboration[]
  discussions   DiscussionThread[]
  quizzes       Quiz[]
  evaluation    AIEvaluation?
  milestones    Milestone[]
  risks         ProjectRisk[]
  deliverables  Deliverable[]
  feedback      ProjectFeedback[]
  document      ProjectDocument?
  activity      Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leaderId])
  @@index([joinCode])
  @@index([departmentId])
}

// ── Admin-controlled app settings (key/value) ──

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ── Supervisor feedback (per group) ───────────

model ProjectFeedback {
  id          String @id @default(cuid())
  workspaceId String
  authorId    String
  authorName  String
  body        String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

// ── Account lifecycle & identity security ─────

/**
 * Reserves a deleted account's email/username for a cooling-off period so a
 * third party can't immediately re-register it and inherit the old identity
 * (account recycling / impersonation).
 */
model ReservedIdentity {
  id        String   @id @default(cuid())
  emailHash String   @unique // SHA-256 of the lowercased email — never the raw address
  until     DateTime
  reason    String   @default("account-deleted")
  createdAt DateTime @default(now())

  @@index([until])
}

/** Pending, verified account-deletion requests (two-step confirmation). */
model AccountDeletionRequest {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── AI-driven Department Resource Hub ─────────

enum ResourceType {
  LINK
  PDF
  GITHUB
  YOUTUBE
  SOFTWARE
  TUTORIAL
  DOCUMENTATION
  PAPER
  DATASET
  TEMPLATE
  OTHER
}

enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ResourceDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum InteractionType {
  VIEW
  SAVE
  HELPFUL
}

model DepartmentResource {
  id              String       @id @default(cuid())
  departmentId    String
  submittedById   String
  submittedByName String
  type            ResourceType @default(LINK)
  title           String
  url             String?
  studentNote     String?      @db.Text

  status ResourceStatus @default(PENDING)

  // AI-generated metadata (filled on approval).
  description  String?             @db.Text
  difficulty   ResourceDifficulty?
  category     String?
  whyUseful    String?             @db.Text
  tags         String[]            @default([])
  topics       String[]            @default([])

  // Moderation.
  moderationReason  String?  @db.Text
  suggestedCategory String?
  moderatedByAI     Boolean  @default(false)
  moderatedAt       DateTime?

  department   Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  interactions ResourceInteraction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId, status])
}

model ResourceInteraction {
  id         String          @id @default(cuid())
  resourceId String
  userId     String
  type       InteractionType @default(VIEW)

  resource DepartmentResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([resourceId, userId, type])
  @@index([userId])
}

// Curated + AI-suggested external catalog used for recommendations.
model TrustedResource {
  id             String             @id @default(cuid())
  departmentCode String? // null = all engineering
  name           String
  url            String
  category       String
  description    String             @db.Text
  difficulty     ResourceDifficulty @default(INTERMEDIATE)
  tags           String[]           @default([])
  topics         String[]           @default([])
  status         ResourceStatus     @default(APPROVED) // AI-suggested start PENDING
  source         String             @default("admin") // seed | ai-suggested | admin

  createdAt DateTime @default(now())

  @@index([departmentCode, status])
}

// Optional learner context to personalize recommendations.
model LearnerProfile {
  userId    String   @id
  modules   String[] @default([])
  skills    String[] @default([])
  goals     String?  @db.Text
  updatedAt DateTime @updatedAt
}

// ── Structured project documentation + supervisor review ──

enum SectionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
}

model ProjectDocument {
  id          String @id @default(cuid())
  workspaceId String @unique

  // When locked, students cannot edit any section (supervisor-controlled).
  locked     Boolean @default(false)
  // Final-report approval (all sections signed off).
  approved   Boolean @default(false)
  approvedAt DateTime?
  // Overall project-completion sign-off by the supervisor.
  completionApproved   Boolean @default(false)
  completionApprovedAt DateTime?

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sections  DocumentSection[]
  versions  ReportVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReportVersion {
  id            String @id @default(cuid())
  documentId    String
  versionNumber Int
  submittedById String
  submittedByName String
  note          String? @db.Text
  // JSON snapshot of every section's title + content at submission time.
  snapshot      String  @db.Text

  document ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId])
}

model DocumentSection {
  id         String        @id @default(cuid())
  documentId String
  key        String // stable section identifier (e.g. "abstract")
  title      String
  content    String        @default("") @db.Text
  order      Int           @default(0)
  status     SectionStatus @default(DRAFT)
  locked     Boolean       @default(false)

  document ProjectDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  comments SectionComment[]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([documentId, key])
  @@index([documentId])
}

model SectionComment {
  id         String  @id @default(cuid())
  sectionId  String
  authorId   String
  authorName String
  body       String  @db.Text
  // True when the comment is a supervisor's correction request.
  isCorrection Boolean @default(false)

  section DocumentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([sectionId])
}

// ── Project management (per group) ────────────

model Milestone {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  dueDate     DateTime?
  done        Boolean   @default(false)
  approved    Boolean   @default(false)
  order       Int       @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

model ProjectRisk {
  id          String  @id @default(cuid())
  workspaceId String
  title       String
  severity    String  @default("MEDIUM") // LOW | MEDIUM | HIGH
  mitigation  String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

model Deliverable {
  id          String  @id @default(cuid())
  workspaceId String
  title       String
  done        Boolean @default(false)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

// ── AI project evaluation (cached report) ─────

model AIEvaluation {
  id          String @id @default(cuid())
  workspaceId String @unique
  data        Json // structured report from the AI
  model       String?
  createdById String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Discussions & quizzes (per group) ─────────

model DiscussionThread {
  id          String @id @default(cuid())
  workspaceId String
  authorId    String
  authorName  String
  title       String

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  DiscussionMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model DiscussionMessage {
  id         String @id @default(cuid())
  threadId   String
  authorId   String
  authorName String
  body       String

  thread DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([threadId])
}

model Quiz {
  id            String  @id @default(cuid())
  workspaceId   String
  createdById   String
  title         String
  description   String?

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

model QuizQuestion {
  id           String @id @default(cuid())
  quizId       String
  text         String
  options      Json // string[]
  correctIndex Int
  order        Int    @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id        String @id @default(cuid())
  quizId    String
  userId    String
  userName  String
  score     Int
  total     Int

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([quizId])
}

// ── Secure group access: requests & invites ───

model JoinRequest {
  id          String            @id @default(cuid())
  workspaceId String
  userId      String
  status      JoinRequestStatus @default(PENDING)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId])
}

model GroupInvite {
  id          String    @id @default(cuid())
  workspaceId String
  token       String    @unique
  expiresAt   DateTime?
  maxUses     Int? // null = unlimited
  uses        Int       @default(0)
  revoked     Boolean   @default(false)
  createdById String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([token])
}

// ── Departments (university organizing layer) ──

model Department {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique // e.g. "EE", "MECH"
  description String?

  createdById String
  createdBy   User   @relation("DeptCreator", fields: [createdById], references: [id])

  members       DepartmentMember[]
  workspaces    Workspace[]
  announcements DepartmentAnnouncement[]
  collaborations WorkspaceCollaboration[]
  resources     DepartmentResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceCollaboration {
  id            String              @id @default(cuid())
  workspaceId   String
  departmentId  String
  status        CollaborationStatus @default(PENDING)
  requestedById String

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, departmentId])
  @@index([departmentId])
}

model DepartmentAnnouncement {
  id           String @id @default(cuid())
  departmentId String
  authorId     String
  title        String
  body         String

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  author     User       @relation("DeptAnnouncementAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([departmentId])
}

model DepartmentMember {
  id           String         @id @default(cuid())
  departmentId String
  userId       String
  role         DepartmentRole @default(MEMBER)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([departmentId, userId])
  @@index([userId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  title       String? // responsibility label set by the leader (e.g. "Design lead")

  // Capability grants — a leader can delegate specific powers to a member
  // without promoting them to a whole new role tier. A member with
  // `canApprove` is what other products would call an "assistant leader".
  canApprove      Boolean @default(false)
  canManageBudget Boolean @default(false)
  canInvite       Boolean @default(false)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ── Activity feed ─────────────────────────────

/// Categories of recorded activity. Only events that CANNOT be derived from
/// existing rows are stored here — see the note on `model Activity`.
enum ActivityKind {
  STAGE
  APPROVAL
  MEMBER
  BUDGET
  DOCUMENT
  AI
  SYSTEM
}

/// User-facing activity feed.
///
/// IMPORTANT — this is NOT the audit log. `AuditLog` is security-shaped
/// (actor, IP, redacted on account deletion) and must not be shown to users.
///
/// This table deliberately stores ONLY events that cannot be derived from
/// existing data: stage changes, approvals, budget updates, members joining.
/// Things that already have a row and a timestamp — completed tasks, uploaded
/// files, scheduled meetings, discussion posts — stay derived at read time, so
/// they need no write path, no backfill, and can never drift out of sync with
/// the records they describe. See `src/lib/activity.ts`, which merges both.
model Activity {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        ActivityKind
  /// Verb phrase, e.g. "moved the project to".
  action      String
  /// What was acted on, e.g. "Testing".
  subject     String

  /// Denormalised so the feed survives account deletion (the User row goes,
  /// the history stays readable and anonymised).
  actorId   String?
  actorName String

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
}

// ── Tasks & time tracking ─────────────────────

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  recurrence  Recurrence   @default(NONE)

  estimatedMinutes Int?
  loggedMinutes    Int  @default(0) // denormalized sum of TimeLog minutes

  // Personal task if workspaceId is null; otherwise a group task.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id])

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  // Self-relation: tasks that must be completed before this one.
  dependsOn    Task[] @relation("TaskDependencies")
  dependedOnBy Task[] @relation("TaskDependencies")

  timeLogs TimeLog[]

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([status])
}

model TimeLog {
  id      String  @id @default(cuid())
  taskId  String
  userId  String
  minutes Int
  note    String?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId])
}

// ── Calendar & notifications ──────────────────

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  location    String?
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean   @default(false)
  type        EventType @default(EVENT)

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation("EventCreator", fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([creatorId])
  @@index([startAt])
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType @default(SYSTEM)
  title  String
  body   String?
  link   String?
  read   Boolean          @default(false)

  // Prevents duplicate auto-generated reminders (NULLs are distinct in Postgres).
  dedupeKey String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, read])
}

// ── Resource library & secure sharing ─────────

model FileResource {
  id          String  @id @default(cuid())
  name        String
  description String?
  mimeType    String
  size        Int
  data        Bytes // stored in Postgres; swappable for S3/Supabase later

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  uploaderId String
  uploader   User   @relation("FileUploader", fields: [uploaderId], references: [id])

  shareLinks ShareLink[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([uploaderId])
}

model ShareLink {
  id       String @id @default(cuid())
  token    String @unique
  fileId   String
  file     FileResource @relation(fields: [fileId], references: [id], onDelete: Cascade)

  expiresAt     DateTime?
  maxDownloads  Int?
  downloadCount Int      @default(0)
  revoked       Boolean  @default(false)

  createdById String
  createdBy   User   @relation("ShareCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([token])
  @@index([fileId])
}

// ── Meetings & attendance ─────────────────────

model Meeting {
  id          String          @id @default(cuid())
  title       String
  description String?
  provider    MeetingProvider @default(OTHER)
  meetingUrl  String?
  startAt     DateTime
  endAt       DateTime?
  minutes     String? // AI-generated minutes & action items

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("MeetingCreator", fields: [createdById], references: [id])

  attendances Attendance[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([startAt])
}

model Attendance {
  id          String           @id @default(cuid())
  meetingId   String
  userId      String
  status      AttendanceStatus @default(ABSENT)
  checkedInAt DateTime?
  note        String?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([meetingId, userId])
  @@index([userId])
}

// ── Budget: contributions & expenses ──────────

model Contribution {
  id          String             @id @default(cuid())
  amount      Decimal            @db.Decimal(12, 2)
  method      ContributionMethod @default(ECOCASH)
  reference   String? // e.g. EcoCash transaction reference
  note        String?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // The member who contributed.
  userId String
  user   User   @relation("Contributor", fields: [userId], references: [id])

  recordedById String // who logged this entry
  createdAt    DateTime @default(now())

  @@index([workspaceId])
  @@index([userId])
}

model Expense {
  id          String          @id @default(cuid())
  amount      Decimal         @db.Decimal(12, 2)
  category    ExpenseCategory @default(OTHER)
  description String
  reference   String?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Optional: who spent the money.
  spentById String?
  spentBy   User?   @relation("ExpenseSpender", fields: [spentById], references: [id])

  recordedById String
  createdAt    DateTime @default(now())

  @@index([workspaceId])
}

// ── Audit log (security requirement) ──────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}
