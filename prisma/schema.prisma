// EngiSync — Prisma schema
// Phase 1 (Foundation): users, roles, auth, workspaces.
// Later phases (tasks, files, meetings, budget, AI) extend this schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────

enum SystemRole {
  GUEST
  INDIVIDUAL
  ADMIN
}

enum Plan {
  FREE
  STUDENT_PREMIUM
  UNIVERSITY
}

/// Workspace roles.
///
/// Deliberately THREE, not six. "Assistant Leader" is not an identity — it is
/// one capability (approving things) that a leader delegates. Modelling it as
/// a role would add a permission tier every future check has to reason about;
/// modelling it as a capability grant on WorkspaceMember keeps the tier count
/// low while expressing exactly the same thing.
///
/// Department Admin and Supervisor are deliberately NOT here: they operate at
/// the department level and are checked separately.
enum WorkspaceRole {
  LEADER
  MEMBER
  /// Read-only: supervisors observing, and guests on shared links.
  VIEWER
}

enum DepartmentRole {
  ADMIN
  MEMBER
  SUPERVISOR
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CollaborationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum EventType {
  EVENT
  DEADLINE
  MEETING
  REMINDER
}

enum NotificationType {
  TASK_DUE
  WORKSPACE
  MENTION
  SYSTEM
}

enum MeetingProvider {
  GOOGLE_MEET
  ZOOM
  MS_TEAMS
  GOOGLE_CLASSROOM
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ContributionMethod {
  ECOCASH
  ONEMONEY
  INNBUCKS
  ZIPIT
  CASH
  BANK
  OTHER
}

/// Verification state of a declared payment.
///
/// NOTE there is deliberately no "AI checked" state. AI/OCR assistance is
/// advisory metadata hanging off the record, never a rung on this ladder —
/// otherwise a payment would stall in limbo whenever AI is disabled or
/// rate-limited, which is most of the time on a free tier.
enum ContributionStatus {
  /// Member says they paid. Nothing confirmed yet.
  DECLARED
  /// A leader (or member with canApprove) confirmed it against their own records.
  VERIFIED
  /// Rejected by a leader — the member may dispute.
  REJECTED
  /// Member disagrees with a rejection. Visible to the supervisor.
  DISPUTED
}

/// Append-only ledger events.
///
/// Verification decisions are NEVER overwritten in place. This is what makes
/// the money trail tamper-evident: a leader cannot quietly flip a payment from
/// verified back to unverified without leaving the history behind.
enum LedgerEventType {
  DECLARED
  VERIFIED
  REJECTED
  DISPUTED
  RESOLVED
  NOTE
}

enum ExpenseCategory {
  COMPONENTS
  TOOLS
  PRINTING
  TRANSPORT
  SOFTWARE
  SERVICES
  OTHER
}

// ── Auth.js models ────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only users
  systemRole    SystemRole @default(INDIVIDUAL)

  // Notification preferences.
  //
  // Two settings, not one, because they answer different questions:
  //   essentialEmails — "tell me things I need to know" (default ON)
  //   emailNotifications — "send me everything else too" (default OFF)
  //
  // A single opt-in flag defaulting to false meant a group leader's
  // announcement reached nobody's inbox, which is a broken product rather
  // than a respectful default.
  essentialEmails    Boolean @default(true)
  emailNotifications Boolean @default(false)

  // Subscription plan (admin-assigned for now; payments later).
  plan Plan @default(FREE)

  // Two-factor
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  // ── Personalization ──
  // Deliberately NO avatar file field. Avatars are generated deterministically
  // from `id` (see lib/personalization.ts): no object storage, no upload
  // moderation queue, and no image bytes on every team list over mobile data.
  // OAuth users keep the provider image in `image` above.
  //
  // `accentColor` and `avatarStyle` hold KEYS into fixed palettes, not raw
  // colours — a free hex value would let a user render their own interface
  // unreadable, so the palette guarantees contrast instead.
  accentColor String?
  avatarStyle String?
  headline    String? @db.VarChar(80)
  bio         String? @db.VarChar(280)
  skills      String[]

  // ── Public portfolio ──
  // OFF by default and it must stay that way: publishing a student's work to
  // the open internet is a decision only they can make. `handle` is the URL at
  // /p/<handle>; unique and lowercase so two people cannot claim the same one
  // by differing in case.
  handle        String?  @unique
  publicProfile Boolean  @default(false)

  accounts     Account[]
  sessions     Session[]
  memberships  WorkspaceMember[]
  ledWorkspaces Workspace[] @relation("WorkspaceLeader")

  createdTasks  Task[] @relation("TaskCreator")
  assignedTasks Task[] @relation("TaskAssignee")
  timeLogs      TimeLog[]
  events        CalendarEvent[] @relation("EventCreator")
  notifications Notification[]
  files         FileResource[]  @relation("FileUploader")
  shareLinks    ShareLink[]     @relation("ShareCreator")
  createdMeetings Meeting[]     @relation("MeetingCreator")
  attendances   Attendance[]
  contributions Contribution[] @relation("Contributor")
  expensesSpent Expense[]      @relation("ExpenseSpender")
  withdrawalRequests WithdrawalRequest[] @relation("WithdrawalRequester")
  deptMemberships   DepartmentMember[]
  createdDepartments Department[]     @relation("DeptCreator")
  deptAnnouncements DepartmentAnnouncement[] @relation("DeptAnnouncementAuthor")
  joinRequests      JoinRequest[]
  pushSubscriptions PushSubscription[]
  passwordResetTokens PasswordResetToken[]
  projectGrants       ProjectGrant[] @relation("ProjectGrantee")
  emailVerificationTokens EmailVerificationToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  endpoint String @unique
  p256dh   String
  auth     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Workspaces (group projects) ───────────────

/// The engineering project lifecycle.
///
/// These are ADVISORY, not gates. Nothing in the app blocks an action because
/// of the current stage — a student who needs to upload a document during
/// "Planning" must always be able to. The stage describes where the project is
/// so progress can be communicated and paced; it never restricts what a team
/// can do.
enum ProjectStage {
  IDEA
  PROPOSAL
  PLANNING
  DESIGN
  SIMULATION
  IMPLEMENTATION
  TESTING
  DOCUMENTATION
  PRESENTATION
  COMPLETED
}

model Workspace {
  id          String  @id @default(cuid())
  name        String
  description String?
  // Join controls
  joinCode    String  @unique
  pinHash     String? // hashed PIN for extra protection

  // Project management
  objectives String?
  scope      String?

  // Engineering lifecycle. `stageEnteredAt` is what makes "are we behind
  // schedule?" answerable — without a timestamp we can only say where a
  // project is, never how long it has been stuck there.
  stage         ProjectStage @default(IDEA)
  stageEnteredAt DateTime    @default(now())
  /// Optional target end date, used to pace expected progress.
  targetEndDate DateTime?

  // Budget
  budgetTarget Decimal? @db.Decimal(12, 2)
  currency     String   @default("USD")

  // Department this group belongs to (nullable for legacy groups).
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Secure access controls.
  maxMembers      Int?     // null = unlimited
  requireApproval Boolean  @default(false)

  leaderId String
  leader   User   @relation("WorkspaceLeader", fields: [leaderId], references: [id])

  members       WorkspaceMember[]
  tasks         Task[]
  events        CalendarEvent[]
  files         FileResource[]
  meetings      Meeting[]
  contributions Contribution[]
  expenses      Expense[]
  joinRequests  JoinRequest[]
  invites       GroupInvite[]
  collaborations WorkspaceCollaboration[]
  discussions   DiscussionThread[]
  quizzes       Quiz[]
  evaluation    AIEvaluation?
  milestones    Milestone[]
  risks         ProjectRisk[]
  deliverables  Deliverable[]
  feedback      ProjectFeedback[]
  document      ProjectDocument?
  activity      Activity[]
  contributionRequests ContributionRequest[]
  grants               ProjectGrant[]
  paymentInstruction   PaymentInstruction?
  withdrawalRequests   WithdrawalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leaderId])
  @@index([joinCode])
  @@index([departmentId])
}

// ── Admin-controlled app settings (key/value) ──

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ── Supervisor feedback (per group) ───────────

model ProjectFeedback {
  id          String @id @default(cuid())
  workspaceId String
  authorId    String
  authorName  String
  body        String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

// ── Account lifecycle & identity security ─────

/**
 * Reserves a deleted account's email/username for a cooling-off period so a
 * third party can't immediately re-register it and inherit the old identity
 * (account recycling / impersonation).
 */
model ReservedIdentity {
  id        String   @id @default(cuid())
  emailHash String   @unique // SHA-256 of the lowercased email — never the raw address
  until     DateTime
  reason    String   @default("account-deleted")
  createdAt DateTime @default(now())

  @@index([until])
}

/** Pending, verified account-deletion requests (two-step confirmation). */
model AccountDeletionRequest {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── AI-driven Department Resource Hub ─────────

enum ResourceType {
  LINK
  PDF
  GITHUB
  YOUTUBE
  SOFTWARE
  TUTORIAL
  DOCUMENTATION
  PAPER
  DATASET
  TEMPLATE
  OTHER
}

enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ResourceDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum InteractionType {
  VIEW
  SAVE
  HELPFUL
}

model DepartmentResource {
  id              String       @id @default(cuid())
  departmentId    String
  submittedById   String
  submittedByName String
  type            ResourceType @default(LINK)
  title           String
  url             String?
  studentNote     String?      @db.Text

  status ResourceStatus @default(PENDING)

  // AI-generated metadata (filled on approval).
  description  String?             @db.Text
  difficulty   ResourceDifficulty?
  category     String?
  whyUseful    String?             @db.Text
  tags         String[]            @default([])
  topics       String[]            @default([])

  // Moderation.
  moderationReason  String?  @db.Text
  suggestedCategory String?
  moderatedByAI     Boolean  @default(false)
  moderatedAt       DateTime?

  department   Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  interactions ResourceInteraction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId, status])
}

model ResourceInteraction {
  id         String          @id @default(cuid())
  resourceId String
  userId     String
  type       InteractionType @default(VIEW)

  resource DepartmentResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([resourceId, userId, type])
  @@index([userId])
}

// Curated + AI-suggested external catalog used for recommendations.
model TrustedResource {
  id             String             @id @default(cuid())
  departmentCode String? // null = all engineering
  name           String
  url            String
  category       String
  description    String             @db.Text
  difficulty     ResourceDifficulty @default(INTERMEDIATE)
  tags           String[]           @default([])
  topics         String[]           @default([])
  status         ResourceStatus     @default(APPROVED) // AI-suggested start PENDING
  source         String             @default("admin") // seed | ai-suggested | admin

  createdAt DateTime @default(now())

  @@index([departmentCode, status])
}

// Optional learner context to personalize recommendations.
model LearnerProfile {
  userId    String   @id
  modules   String[] @default([])
  skills    String[] @default([])
  goals     String?  @db.Text
  updatedAt DateTime @updatedAt
}

// ── Structured project documentation + supervisor review ──

enum SectionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
}

model ProjectDocument {
  id          String @id @default(cuid())
  workspaceId String @unique

  // When locked, students cannot edit any section (supervisor-controlled).
  locked     Boolean @default(false)
  // Final-report approval (all sections signed off).
  approved   Boolean @default(false)
  approvedAt DateTime?
  // Overall project-completion sign-off by the supervisor.
  completionApproved   Boolean @default(false)
  completionApprovedAt DateTime?

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sections  DocumentSection[]
  versions  ReportVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReportVersion {
  id            String @id @default(cuid())
  documentId    String
  versionNumber Int
  submittedById String
  submittedByName String
  note          String? @db.Text
  // JSON snapshot of every section's title + content at submission time.
  snapshot      String  @db.Text

  document ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId])
}

model DocumentSection {
  id         String        @id @default(cuid())
  documentId String
  key        String // stable section identifier (e.g. "abstract")
  title      String
  content    String        @default("") @db.Text
  order      Int           @default(0)
  status     SectionStatus @default(DRAFT)
  locked     Boolean       @default(false)

  document ProjectDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  comments SectionComment[]
  /// Engineering evidence filed against this section — the schematic for
  /// "Circuit Diagrams", the STEP model for "System Design", and so on.
  attachments FileResource[]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([documentId, key])
  @@index([documentId])
}

model SectionComment {
  id         String  @id @default(cuid())
  sectionId  String
  authorId   String
  authorName String
  body       String  @db.Text
  // True when the comment is a supervisor's correction request.
  isCorrection Boolean @default(false)

  section DocumentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([sectionId])
}

// ── Project management (per group) ────────────

model Milestone {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  dueDate     DateTime?
  done        Boolean   @default(false)
  approved    Boolean   @default(false)
  order       Int       @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

model ProjectRisk {
  id          String  @id @default(cuid())
  workspaceId String
  title       String
  severity    String  @default("MEDIUM") // LOW | MEDIUM | HIGH
  mitigation  String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

model Deliverable {
  id          String  @id @default(cuid())
  workspaceId String
  title       String
  done        Boolean @default(false)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

// ── AI project evaluation (cached report) ─────

model AIEvaluation {
  id          String @id @default(cuid())
  workspaceId String @unique
  data        Json // structured report from the AI
  model       String?
  createdById String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Discussions & quizzes (per group) ─────────

model DiscussionThread {
  id          String @id @default(cuid())
  workspaceId String
  authorId    String
  authorName  String
  title       String

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  DiscussionMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model DiscussionMessage {
  id         String @id @default(cuid())
  threadId   String
  authorId   String
  authorName String
  body       String

  thread DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([threadId])
}

model Quiz {
  id            String  @id @default(cuid())
  workspaceId   String
  createdById   String
  title         String
  description   String?

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

model QuizQuestion {
  id           String @id @default(cuid())
  quizId       String
  text         String
  options      Json // string[]
  correctIndex Int
  order        Int    @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id        String @id @default(cuid())
  quizId    String
  userId    String
  userName  String
  score     Int
  total     Int

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([quizId])
}

// ── Secure group access: requests & invites ───

model JoinRequest {
  id          String            @id @default(cuid())
  workspaceId String
  userId      String
  status      JoinRequestStatus @default(PENDING)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId])
}

model GroupInvite {
  id          String    @id @default(cuid())
  workspaceId String
  token       String    @unique
  expiresAt   DateTime?
  maxUses     Int? // null = unlimited
  uses        Int       @default(0)
  revoked     Boolean   @default(false)
  createdById String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([token])
}

// ── Departments (university organizing layer) ──

model Department {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique // e.g. "EE", "MECH"
  description String?

  createdById String
  createdBy   User   @relation("DeptCreator", fields: [createdById], references: [id])

  members       DepartmentMember[]
  workspaces    Workspace[]
  announcements DepartmentAnnouncement[]
  collaborations WorkspaceCollaboration[]
  resources     DepartmentResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceCollaboration {
  id            String              @id @default(cuid())
  workspaceId   String
  departmentId  String
  status        CollaborationStatus @default(PENDING)
  requestedById String

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, departmentId])
  @@index([departmentId])
}

model DepartmentAnnouncement {
  id           String @id @default(cuid())
  departmentId String
  authorId     String
  title        String
  body         String

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  author     User       @relation("DeptAnnouncementAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([departmentId])
}

model DepartmentMember {
  id           String         @id @default(cuid())
  departmentId String
  userId       String
  role         DepartmentRole @default(MEMBER)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([departmentId, userId])
  // NOTE: there is deliberately NO `@@unique([userId])` here.
  //
  // The rule is "one department per STUDENT", not per person. A university
  // administrator is legitimately the ADMIN of every department — the seed
  // data alone puts admin@engisync.dev in eight — so a blanket unique
  // constraint would strip those departments of their administrator.
  //
  // Enforcement therefore lives in `assertSingleDepartment()`
  // (lib/department.ts), which every write path must call. It applies the rule
  // to MEMBER rows only.
  @@index([userId])
}

/// Why an outsider can see a project.
///
/// Both roles carry the SAME read-only ceiling. They are distinguished only so
/// the team can tell at a glance who is marking their work and who is merely
/// observing — a distinction that matters socially even though it does not
/// change a single permission.
enum ProjectGrantRole {
  /// The academic responsible for reviewing and signing off this project.
  SUPERVISOR
  /// An additional lecturer invited to observe. No approval powers.
  LECTURER
}

/// Explicit, revocable permission for a non-member to see a project.
///
/// WHY THIS EXISTS
/// ---------------
/// Supervisor access used to be IMPLICIT and department-wide: holding the
/// SUPERVISOR role in a department granted sight of every project in it,
/// forever, with no record of it and no way for a team to know who was
/// looking. `listSupervisedProjects` simply returned every workspace in the
/// department. There was no such thing as "inviting" a supervisor, so the
/// product could not honour its own promise that a project is private to its
/// members and the people they invite.
///
/// A grant is now a row: someone created it, it names who it is for, and it
/// can be revoked. That makes supervision consented, visible and auditable
/// rather than ambient.
///
/// REVOCATION IS SOFT. `revokedAt` is set rather than the row deleted, so the
/// history of who could see the work — and when — survives. This is the same
/// reasoning as LedgerEvent and the publication archive: records that exist to
/// establish accountability must not be quietly erasable by the party they
/// hold accountable.
model ProjectGrant {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("ProjectGrantee", fields: [userId], references: [id], onDelete: Cascade)

  role ProjectGrantRole @default(SUPERVISOR)

  grantedById String?
  /// Denormalised so the record stays readable after an account is deleted.
  grantedByName String
  /// Set when the grant is withdrawn. Null = active.
  revokedAt   DateTime?
  revokedById String?

  createdAt DateTime @default(now())

  /// One grant per person per project. Re-inviting someone previously revoked
  /// reactivates this row rather than creating a second, which keeps "who has
  /// access?" a question with exactly one answer per person.
  @@unique([workspaceId, userId])
  @@index([userId, revokedAt])
  @@index([workspaceId, revokedAt])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  title       String? // responsibility label set by the leader (e.g. "Design lead")

  // Capability grants — a leader can delegate specific powers to a member
  // without promoting them to a whole new role tier. A member with
  // `canApprove` is what other products would call an "assistant leader".
  canApprove      Boolean @default(false)
  canManageBudget Boolean @default(false)
  canInvite       Boolean @default(false)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ── Professional withdrawal from a group ──────

enum WithdrawalStatus {
  /// Member asked to leave; leader hasn't decided.
  PENDING
  /// Leader agreed; waiting for supervisor confirmation (departments only).
  LEADER_APPROVED
  /// Fully approved — membership removed.
  COMPLETED
  /// Leader or supervisor said no, with a reason.
  REJECTED
  /// Requester changed their mind while pending.
  CANCELLED
}

/// A member cannot simply vanish from a group. Leaving is a request with a
/// reason, blocked while the member still owns open tasks, approved by the
/// leader, and (when the group belongs to a department) confirmed by a
/// supervisor. The record survives the departure — it IS the accountability.
model WithdrawalRequest {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation("WithdrawalRequester", fields: [userId], references: [id], onDelete: Cascade)
  status      WithdrawalStatus @default(PENDING)
  reason      String

  leaderNote     String?
  supervisorNote String?
  decidedById    String?

  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([workspaceId, status])
  @@index([userId])
}

// ── Engineering repository (publication & archive) ──

enum PublicationStatus {
  /// Leader is assembling the submission.
  DRAFT
  /// Submitted, waiting for supervisor sign-off.
  PENDING_APPROVAL
  /// In the permanent archive.
  PUBLISHED
  /// Supervisor sent it back with a reason.
  REJECTED
}

enum PublishedFileKind {
  REPORT
  PRESENTATION
  SOURCE_CODE
  CAD
  SIMULATION
  BOM
  IMAGE
  VIDEO
  OTHER
}

/// Who can see a published project. The multi-tenancy seam: today DEPARTMENT
/// vs UNIVERSITY; a future cross-university tier slots in as a new value.
enum PublishedVisibility {
  DEPARTMENT
  UNIVERSITY
}

/// A published project — the department's permanent knowledge base.
///
/// DESIGN: this is a SNAPSHOT, deliberately without foreign keys to User,
/// Workspace or Department. Authors are stored as display-name strings, the
/// department as a name. The source workspace can be deleted, members can
/// delete their accounts, and the archive record survives untouched — an
/// archive that can be mutated or cascaded away by its source is not an
/// archive. The optional id fields below are plain strings for provenance,
/// not relations.
model PublishedProject {
  id   String @id @default(cuid())
  /// Permanent human-readable identifier, e.g. "ES-2026-0042".
  slug String @unique

  status     PublicationStatus   @default(DRAFT)
  visibility PublishedVisibility @default(DEPARTMENT)

  title    String
  abstract String @db.Text
  year     Int
  license  String @default("All rights reserved")

  /// Searchable facets.
  keywords    String[]
  disciplines String[]
  components  String[] // e.g. "ESP32", "L298N"
  languages   String[] // e.g. "C++", "Python"

  /// Snapshotted names — never joined, never cascaded.
  departmentName String
  authors        String[]
  supervisorName String?

  /// Provenance (plain strings, no FK — see design note).
  workspaceId    String?
  departmentId   String?
  submittedById  String
  approvedById   String?

  rejectionReason String?
  downloads       Int     @default(0)

  createdAt   DateTime  @default(now())
  submittedAt DateTime?
  publishedAt DateTime?

  files PublishedFile[]

  @@index([status, year])
  @@index([departmentId, status])
  @@index([workspaceId])
}

/// Archived file bytes, copied from the workspace at approval time.
/// Deliberately duplicates storage rather than referencing FileResource:
/// the workspace's files cascade-delete with the workspace; these must not.
model PublishedFile {
  id          String            @id @default(cuid())
  publishedId String
  published   PublishedProject  @relation(fields: [publishedId], references: [id], onDelete: Cascade)
  kind        PublishedFileKind @default(OTHER)
  name        String
  mimeType    String
  size        Int
  data        Bytes

  createdAt DateTime @default(now())

  @@index([publishedId])
}

// ── Activity feed ─────────────────────────────

/// Categories of recorded activity. Only events that CANNOT be derived from
/// existing rows are stored here — see the note on `model Activity`.
enum ActivityKind {
  STAGE
  APPROVAL
  MEMBER
  BUDGET
  DOCUMENT
  AI
  SYSTEM
}

/// User-facing activity feed.
///
/// IMPORTANT — this is NOT the audit log. `AuditLog` is security-shaped
/// (actor, IP, redacted on account deletion) and must not be shown to users.
///
/// This table deliberately stores ONLY events that cannot be derived from
/// existing data: stage changes, approvals, budget updates, members joining.
/// Things that already have a row and a timestamp — completed tasks, uploaded
/// files, scheduled meetings, discussion posts — stay derived at read time, so
/// they need no write path, no backfill, and can never drift out of sync with
/// the records they describe. See `src/lib/activity.ts`, which merges both.
model Activity {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        ActivityKind
  /// Verb phrase, e.g. "moved the project to".
  action      String
  /// What was acted on, e.g. "Testing".
  subject     String

  /// Denormalised so the feed survives account deletion (the User row goes,
  /// the history stays readable and anonymised).
  actorId   String?
  actorName String

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
}

// ── Tasks & time tracking ─────────────────────

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  recurrence  Recurrence   @default(NONE)

  estimatedMinutes Int?
  loggedMinutes    Int  @default(0) // denormalized sum of TimeLog minutes

  // Personal task if workspaceId is null; otherwise a group task.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id])

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  // Self-relation: tasks that must be completed before this one.
  dependsOn    Task[] @relation("TaskDependencies")
  dependedOnBy Task[] @relation("TaskDependencies")

  timeLogs TimeLog[]

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([status])
}

model TimeLog {
  id      String  @id @default(cuid())
  taskId  String
  userId  String
  minutes Int
  note    String?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId])
}

// ── Calendar & notifications ──────────────────

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  location    String?
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean   @default(false)
  type        EventType @default(EVENT)

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation("EventCreator", fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([creatorId])
  @@index([startAt])
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType @default(SYSTEM)
  title  String
  body   String?
  link   String?
  read   Boolean          @default(false)

  // Prevents duplicate auto-generated reminders (NULLs are distinct in Postgres).
  dedupeKey String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, read])
}

// ── Resource library & secure sharing ─────────

/// What a file IS, in engineering terms — not what its bytes happen to be.
///
/// The distinction matters because "a PNG" tells you nothing useful: a PNG can
/// be a flowchart, an oscilloscope trace or a photo of a breadboard, and those
/// belong in three different chapters of the report. Kind is what lets a file
/// be filed, searched and checked for completeness.
enum EvidenceKind {
  FLOWCHART
  CIRCUIT
  SCHEMATIC
  PCB
  CAD
  SIMULATION
  SOURCE_CODE
  DATASET
  REPORT
  IMAGE
  VIDEO
  BOM
  DATASHEET
  OTHER
}

model FileResource {
  id          String  @id @default(cuid())
  name        String
  description String?
  mimeType    String
  size        Int

  /// NULLABLE since evidence may live elsewhere. A GitHub repository is the
  /// canonical form of source-code evidence for most student projects, and
  /// copying a snapshot of it into Postgres would be both wasteful and
  /// immediately stale. Exactly one of `data` or `externalUrl` is set.
  data Bytes?
  /// Set for link-based evidence (e.g. a GitHub repo). Never fetched by the
  /// server — stored as data and rendered as a link, which keeps this free of
  /// SSRF risk.
  externalUrl String?

  /// ── What makes a file EVIDENCE rather than storage ──
  ///
  /// Before this existed, an upload had a workspace and nothing else, so files
  /// landed in one flat per-user list ordered by upload time. A member could
  /// upload their report and then genuinely be unable to find it again,
  /// because the system had no representation of where it belonged.
  ///
  /// A file now points at the document section it is evidence FOR.
  /// Null = not yet filed; those surface in an "Unfiled" tray rather than
  /// disappearing, which is what makes the backfill of existing rows safe.
  documentSectionId String?
  documentSection   DocumentSection? @relation(fields: [documentSectionId], references: [id], onDelete: SetNull)

  kind EvidenceKind @default(OTHER)

  /// Versioning by supersession, not by overwrite. A new upload of the same
  /// evidence creates a NEW row pointing at the one it replaces, so a
  /// supervisor reviewing v1 can still see exactly what they reviewed.
  /// One-to-one both ways: a file supersedes at most one predecessor and is
  /// superseded by at most one successor.
  version      Int           @default(1)
  supersedesId String?       @unique
  supersedes   FileResource? @relation("EvidenceVersion", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy FileResource? @relation("EvidenceVersion")

  /// SHA-256 of the bytes. Catches the same file being uploaded twice —
  /// deterministic and explainable, unlike similarity heuristics.
  sha256 String?

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  uploaderId String
  uploader   User   @relation("FileUploader", fields: [uploaderId], references: [id])

  shareLinks ShareLink[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([uploaderId])
  @@index([documentSectionId])
  @@index([workspaceId, sha256])
}

model ShareLink {
  id       String @id @default(cuid())
  token    String @unique
  fileId   String
  file     FileResource @relation(fields: [fileId], references: [id], onDelete: Cascade)

  expiresAt     DateTime?
  maxDownloads  Int?
  downloadCount Int      @default(0)
  revoked       Boolean  @default(false)

  createdById String
  createdBy   User   @relation("ShareCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([token])
  @@index([fileId])
}

// ── Meetings & attendance ─────────────────────

model Meeting {
  id          String          @id @default(cuid())
  title       String
  description String?
  provider    MeetingProvider @default(OTHER)
  meetingUrl  String?
  startAt     DateTime
  endAt       DateTime?
  minutes     String? // AI-generated minutes & action items

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("MeetingCreator", fields: [createdById], references: [id])

  attendances Attendance[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([startAt])
}

model Attendance {
  id          String           @id @default(cuid())
  meetingId   String
  userId      String
  status      AttendanceStatus @default(ABSENT)
  checkedInAt DateTime?
  note        String?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([meetingId, userId])
  @@index([userId])
}

// ── Budget: contributions & expenses ──────────

/// A request for money: "PCB manufacturing, US$120, $15 each, due 15 August".
model ContributionRequest {
  id       String  @id @default(cuid())
  title    String
  purpose  String?
  /// Total the project needs to raise.
  targetAmount    Decimal  @db.Decimal(12, 2)
  /// Expected share per member, if the leader split it evenly.
  perMemberAmount Decimal? @db.Decimal(12, 2)
  currency String   @default("USD")
  dueDate  DateTime?
  closed   Boolean  @default(false)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contributions Contribution[]

  @@index([workspaceId, closed])
}

/// Where members should send money. EngiSync only displays these details —
/// it never touches the funds.
model PaymentInstruction {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  ecocashNumber     String?
  ecocashName       String?
  oneMoneyNumber    String?
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  notes             String?

  updatedById String?
  updatedAt   DateTime @updatedAt
}

model Contribution {
  id          String             @id @default(cuid())
  amount      Decimal            @db.Decimal(12, 2)
  method      ContributionMethod @default(ECOCASH)
  reference   String? // e.g. EcoCash transaction reference
  note        String?

  status ContributionStatus @default(DECLARED)

  /// Currency the member actually paid in. Zimbabwe runs USD and ZWG side by
  /// side, so a single project currency would make totals meaningless.
  currency     String  @default("USD")
  /// Rate to the project's base currency, captured at declaration time so
  /// historical totals stay stable when rates move.
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)
  /// amount × exchangeRate, denormalised so totals never re-derive from a
  /// rate that has since changed.
  baseAmount   Decimal @db.Decimal(12, 2)

  /// When the member says the transfer happened (not when they logged it).
  paidAt DateTime?

  requestId String?
  request   ContributionRequest? @relation(fields: [requestId], references: [id])

  receiptFileId String?
  /// SHA-256 of the uploaded receipt bytes — catches an identical file being
  /// submitted twice. Deterministic and explainable, unlike AI image forensics.
  receiptHash   String?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // The member who contributed.
  userId String
  user   User   @relation("Contributor", fields: [userId], references: [id])

  verifiedById String?
  verifiedAt   DateTime?

  recordedById String // who logged this entry
  createdAt    DateTime @default(now())

  events LedgerEvent[]

  /// The single strongest anti-fraud control in this module: the same
  /// transaction reference cannot be claimed twice within a project.
  /// Postgres treats NULLs as distinct, so cash payments (no reference) are
  /// unaffected.
  @@unique([workspaceId, reference])
  @@index([workspaceId])
  @@index([userId])
  @@index([workspaceId, status])
}

/// Append-only history for a payment. Never updated, never deleted.
model LedgerEvent {
  id             String          @id @default(cuid())
  contributionId String
  contribution   Contribution    @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  type           LedgerEventType
  note           String?

  actorId   String?
  /// Denormalised so history stays readable after an account is deleted.
  actorName String

  createdAt DateTime @default(now())

  @@index([contributionId, createdAt])
}

model Expense {
  id          String          @id @default(cuid())
  amount      Decimal         @db.Decimal(12, 2)
  category    ExpenseCategory @default(OTHER)
  description String
  reference   String?

  /// Same per-transaction currency handling as contributions.
  currency     String  @default("USD")
  exchangeRate Decimal @default(1) @db.Decimal(18, 6)
  baseAmount   Decimal @db.Decimal(12, 2)

  vendor        String?
  spentAt       DateTime?
  /// Receipt / invoice / quotation backing this expense.
  receiptFileId String?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Optional: who spent the money.
  spentById String?
  spentBy   User?   @relation("ExpenseSpender", fields: [spentById], references: [id])

  recordedById String
  createdAt    DateTime @default(now())

  @@index([workspaceId])
}

/// Rate-limit counters that survive across serverless instances.
///
/// WHY A TABLE AND NOT REDIS
/// The obvious answer is Upstash, and it would be faster. But it is another
/// account, another key, another free tier to run out of, and another thing
/// that can be down — for a counter that is read a few times per user per day.
/// Postgres is already here, already has the connection open, and gives the
/// one thing that actually matters: a single atomic statement that every
/// instance agrees on.
///
/// WHY NOT EVERY LIMIT USES IT
/// Each check costs a round trip, and this database is ~271ms away. Spending
/// that on a profile-edit throttle would be a poor trade; spending it to stop
/// a password being brute-forced, or to stop the Gemini free tier being
/// exhausted, is obviously worth it. See `lib/rate-limit.ts` for which callers
/// use which and why.
model RateLimit {
  /// Caller identity, e.g. "ai-free:<userId>:2026-07-31".
  key     String   @id
  count   Int      @default(0)
  /// When the window rolls over. Rows past this are reusable and prunable.
  resetAt DateTime

  @@index([resetAt])
}

// ── Audit log (security requirement) ──────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}
