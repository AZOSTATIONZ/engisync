    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "15.1.11",
    "next-auth": "5.0.0-beta.25",
    "next-themes": "^0.4.4",
    "nodemailer": "^6.9.16",
    "otpauth": "^9.3.6",
    "qrcode": "^1.5.4",
    "recharts": "^2.15.0",
