{
  "name": "engisync",
  "version": "0.1.0",
  "private": true,
  "description": "EngiSync — collaboration & productivity platform for university engineering students",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
