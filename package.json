    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.11",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
